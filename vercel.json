{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/seo/dashboard/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portable-dishwashing-trailer-rental/",
      "destination": "/dishwashing-trailer-rental/",
      "permanent": true
    },
    {
      "source": "/services/dishwashing-trailers/22ft/",
      "destination": "/22ft-dishwashing-trailer-rental/",
      "permanent": true
    },
    {
      "source": "/services/dishwashing-trailers/24ft/",
      "destination": "/24ft-dishwashing-trailer-rental/",
      "permanent": true
    },
    {
      "source": "/services/dishwashing-trailers/26ft/",
      "destination": "/26ft-dishwashing-trailer-rental/",
      "permanent": true
    },
    {
      "source": "/services/dishwashing-trailers/38ft-conveyor/",
      "destination": "/38ft-conveyor-dishwashing-trailer-rental/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/commercial-dishwashing-facility-contact/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/commercial-dishwashing-facility-contact/",
      "permanent": true
    }
  ]
}
